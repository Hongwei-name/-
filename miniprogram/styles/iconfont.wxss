/**
 * 图标字体样式
 * 字体来源：iconfont.cn 自建项目「行屿」（线性描边风格，项目 id 5223881）。
 *
 * 加载方式：字体以 base64 内嵌（data URI），不依赖运行时加载，
 * 避免 wxss 引用本地 ttf 文件在部分真机触发 "Failed to load local font resource"。
 * 字形与 unicode 对照见 tools/font-src/iconfont.json。
 */
@font-face {
  font-family: 'iconfont';
  src: url("data:font/truetype;charset=utf-8;base64,") format('truetype');
  font-weight: normal;
  font-style: normal;
}

.iconfont {
  font-family: 'iconfont';
  font-size: 32rpx;
  line-height: 1;
  color: inherit;
  font-style: normal;
  font-weight: normal;
  -webkit-font-smoothing: antialiased;
}

/* --- 图标映射（unicode 来自 iconfont.cn 项目 5223881） --- */
