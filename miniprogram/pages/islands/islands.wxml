<view class="page">
  <top-nav title="我的小岛" show-back="{{true}}" bindback="onBack" />
  <view wx:if="{{islands.length}}" class="collection-header">
    <view>
      <view class="collection-eyebrow">收藏档案</view>
      <view class="collection-title">我的小岛</view>
    </view>
    <view class="collection-count">
      <text class="collection-count-num">{{islands.length}}</text>
      <text class="collection-count-unit">处</text>
    </view>
  </view>
  <!-- 排序切换 -->
  <view class="sort-bar">
    <view
      class="sort-item {{sortMode === 'time' ? 'active' : ''}}"
      data-mode="time"
      bindtap="onSortChange"
    >按标记时间</view>
    <view
      class="sort-item {{sortMode === 'distance' ? 'active' : ''}}"
      data-mode="distance"
      bindtap="onSortChange"
    >按距离最近</view>
    <view class="sort-tip" bindtap="goPhotoImport">
      <text class="iconfont icon-photo-add sort-tip-icon"></text> 照片归集
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{islands.length}}" class="list">
    <view
      wx:for="{{islands}}"
      wx:key="id"
      class="island-item"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <text class="iconfont icon-island island-badge"></text>
      <view class="island-main">
        <view class="island-name">{{item.name}}<text wx:if="{{item.visitedText}}" class="visited-label">{{item.visitedText}}</text></view>
        <view class="island-addr">{{item.address || '暂无地址'}}</view>
        <view class="island-meta">
          <text>照片 {{item.photoCount}} 张</text>
          <text class="dot">·</text>
          <text>{{item.createdAtText}}</text>
          <text wx:if="{{item.distanceText}}" class="dot">·</text>
          <text wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
        </view>
        <view wx:if="{{item.remark}}" class="island-remark">备注：{{item.remark}}</view>
      </view>
      <view class="island-ops">
        <view class="op" catchtap="onEdit" data-id="{{item.id}}">编辑</view>
        <view class="op op-del" catchtap="onDelete" data-id="{{item.id}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{!islands.length}}" class="empty">
    <text class="iconfont icon-island empty-icon"></text>
    <view class="empty-text">还没有标记任何小岛</view>
    <view class="empty-sub">在地图上点击位置，或搜索景点后点击「标记」，即可收藏你的第一座小岛</view>
    <button class="btn btn-primary empty-btn" bindtap="goMap">去地图看看</button>
  </view>
</view>
