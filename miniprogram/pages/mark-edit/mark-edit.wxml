<view class="page">
  <top-nav title="{{isEdit ? '编辑小岛' : '标记小岛'}}" show-back="{{true}}" bindback="onBack" />
  <view class="card">
    <view class="form-item">
      <view class="form-label">名称</view>
      <input
        class="form-input"
        placeholder="如：西湖 · 湖心岛"
        placeholder-class="input-ph"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        maxlength="30"
      />
    </view>

    <view class="form-item">
      <view class="form-label">地址</view>
      <input
        class="form-input"
        placeholder="地点地址（可修改）"
        placeholder-class="input-ph"
        value="{{form.address}}"
        data-field="address"
        bindinput="onInput"
        maxlength="60"
      />
    </view>

    <view class="form-item">
      <view class="form-label">坐标</view>
      <view class="form-coord">{{form.lng}}, {{form.lat}}</view>
    </view>

    <view class="form-item">
      <view class="form-label">备注</view>
      <textarea
        class="form-textarea"
        placeholder="给这座小岛写点备注（可选）"
        placeholder-class="input-ph"
        value="{{form.remark}}"
        data-field="remark"
        bindinput="onInput"
        maxlength="200"
      />
    </view>

    <button class="btn btn-primary btn-block save-btn" bindtap="onSave">保存</button>
  </view>
</view>
