/* 标记编辑 */
.page {
  min-height: 100vh;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6B7686;
  margin-bottom: 12rpx;
}

.form-input {
  background: #F2F4F9;
  border-radius: 14rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 29rpx;
}

.input-ph {
  color: #B6BECB;
}

.form-coord {
  background: #F7F9FD;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #4A5568;
  word-break: break-all;
}

.form-textarea {
  background: #F2F4F9;
  border-radius: 14rpx;
  width: 100%;
  height: 180rpx;
  padding: 20rpx 24rpx;
  font-size: 29rpx;
}

.save-btn {
  margin-top: 16rpx;
}

/* Edit surface */
.page {
  background: #F4F8F8;
  padding-bottom: 72rpx;
}

.form-label {
  color: #52616D;
  font-weight: 600;
}

.form-input,
.form-textarea {
  background: #FFFFFF;
  border: 1rpx solid #D8E6E5;
  border-radius: 12rpx;
}

.form-coord {
  background: #EDF6F5;
  border: 1rpx solid #D8E6E5;
  border-radius: 12rpx;
  color: #52616D;
}

.card {
  border-top: 6rpx solid #0E7784;
}
