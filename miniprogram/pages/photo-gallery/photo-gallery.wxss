.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
  background: #F4F8F8;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 18rpx;
}

.count {
  display: flex;
  align-items: baseline;
}

.count-number {
  color: #15232B;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.count-unit {
  margin-left: 10rpx;
  color: #718087;
  font-size: 24rpx;
}

.add-button,
.add-empty-button {
  margin: 0;
  border-radius: 8rpx;
  background: #0E7784;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.2;
}

.add-button {
  padding: 18rpx 26rpx;
}

.add-button::after,
.add-empty-button::after {
  border: 0;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 10rpx 24rpx 40rpx;
}

.photo-cell {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8rpx;
  background: #E4EFEE;
}

.photo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-unavailable {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #77918F;
  font-size: 20rpx;
}

.photo-unavailable-icon {
  margin-bottom: 8rpx;
  font-size: 46rpx;
}

.photo-overlay {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 24rpx 10rpx 10rpx;
  background: linear-gradient(transparent, rgba(21, 35, 43, 0.72));
}

.photo-island,
.photo-time {
  display: block;
  overflow: hidden;
  color: #FFFFFF;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.photo-island {
  font-size: 21rpx;
  font-weight: 600;
}

.photo-time {
  margin-top: 3rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 18rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 40rpx 0;
}

.empty-icon {
  color: #A8BFBD;
  font-size: 76rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: #52616D;
  font-size: 28rpx;
}

.add-empty-button {
  margin-top: 32rpx;
  padding: 20rpx 48rpx;
}
