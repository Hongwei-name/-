<view class="page">
  <top-nav title="我的" />

  <view class="profile-hero">
    <view class="avatar" bindtap="onAuthorize">
      <image wx:if="{{profile && profile.avatarUrl}}" class="avatar-image" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder">
        <view class="avatar-head"></view>
        <view class="avatar-body"></view>
      </view>
    </view>
    <view class="profile-copy">
      <view class="profile-name">{{profile ? profile.nickName : '微信用户'}}</view>
      <view class="profile-status">{{profile ? (cloudReady ? '已授权并开启云端同步' : '已授权，本地数据安全保存') : '授权后展示微信头像和昵称'}}</view>
    </view>
    <button class="profile-action" bindtap="onAuthorize" loading="{{authorizing}}">
      {{profile ? '更新资料' : '微信授权'}}
    </button>
  </view>

  <view class="stats-row">
    <view class="stat-cell" bindtap="goIslands">
      <text class="stat-number">{{islandCount}}</text>
      <text class="stat-label">我的小岛</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-cell" bindtap="goPhotos">
      <text class="stat-number">{{photoCount}}</text>
      <text class="stat-label">归集照片</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goIslands">
      <view class="menu-icon island-icon"><text class="iconfont icon-island"></text></view>
      <view class="menu-copy">
        <text class="menu-title">我的小岛</text>
        <text class="menu-sub">查看收藏地点和足迹</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPhotos">
      <view class="menu-icon photo-icon"><text class="iconfont icon-photo"></text></view>
      <view class="menu-copy">
        <text class="menu-title">照片归集</text>
        <text class="menu-sub">整理旅行影像</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goTour">
      <view class="menu-icon tour-icon"><text class="iconfont icon-route"></text></view>
      <view class="menu-copy">
        <text class="menu-title">全部小岛路线</text>
        <text class="menu-sub">计算依次到访顺序</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onSync">
      <view class="menu-icon sync-icon"><text class="iconfont icon-refresh"></text></view>
      <view class="menu-copy">
        <text class="menu-title">云端同步</text>
        <text class="menu-sub">{{cloudReady ? '同步本地旅行数据' : '尚未连接云端'}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
