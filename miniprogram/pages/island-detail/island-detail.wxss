/* 小岛详情 */
.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title-icon {
  font-size: 36rpx;
  color: #2B5CD9;
  margin-right: 12rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2733;
  flex: 1;
  word-break: break-all;
}

.info-row {
  display: flex;
  margin-top: 18rpx;
  font-size: 26rpx;
}

.info-label {
  width: 140rpx;
  color: #9AA3B2;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #6B7686;
  word-break: break-all;
}

.action-row {
  display: flex;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.act {
  flex: 1;
  margin: 8rpx;
  min-width: 190rpx;
}

/* 照片 */
.photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-btn {
  font-size: 26rpx;
  color: #2B5CD9;
  background: #EAF0FF;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.photo-item {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-gps {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}

.gps-icon {
  font-size: 18rpx;
  color: #FFFFFF;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
}

.photo-empty-icon {
  font-size: 64rpx;
  color: #B6C2D6;
}

.photo-empty-text {
  margin-top: 16rpx;
  color: #6B7686;
  font-size: 28rpx;
}

.photo-empty-sub {
  margin-top: 10rpx;
  color: #9AA3B2;
  font-size: 24rpx;
  text-align: center;
  padding: 0 30rpx;
}

.photo-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B6BECB;
  text-align: center;
}

/* Detail hierarchy */
.page {
  background: #F4F8F8;
  padding-bottom: 72rpx;
}

.title-icon,
.add-btn {
  color: #0E7784;
}

.title {
  color: #15232B;
}

.add-btn {
  background: #E4F3F2;
  border: 1rpx solid #CFE7E5;
  border-radius: 10rpx;
}

.photo-item {
  border-radius: 8rpx;
}
