/* 自定义 tabBar */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: rgba(250, 253, 252, 0.98);
  border-top: 1rpx solid #E1ECEB;
  min-height: 136rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 136rpx;
  padding: 14rpx 0 12rpx;
  color: #84949A;
  box-sizing: border-box;
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 48rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tab-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  opacity: 0.68;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.35;
}

/* 选中态仅强调文字和图标，不添加图标底板。 */
.tab-item.active {
  color: #0E7784;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-item.active .tab-text {
  font-weight: 600;
}
