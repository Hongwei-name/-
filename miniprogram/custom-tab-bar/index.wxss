@import "/styles/iconfont.wxss";

/* 自定义 tabBar（字体图标，简约现代） */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: rgba(250, 253, 252, 0.98);
  border-top: 1rpx solid #E1ECEB;
  min-height: 136rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 136rpx;
  padding: 14rpx 0 12rpx;
  color: #84949A;
  box-sizing: border-box;
}

.tab-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 48rpx;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.tab-icon {
  display: block;
  font-size: 42rpx;
  line-height: 48rpx;
}

.profile-tab-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  color: currentColor;
  box-sizing: border-box;
}

.profile-tab-icon::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 13rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.profile-tab-icon::after {
  content: '';
  position: absolute;
  left: 5rpx;
  bottom: 2rpx;
  width: 32rpx;
  height: 18rpx;
  border: 2.5rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
  box-sizing: border-box;
}

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.35;
}

/* 选中态：固定大小的图标底板 + 文字颜色，避免图标跳动。 */
.tab-item.active {
  color: #0E7784;
}

.tab-item.active .tab-icon-wrap {
  background: #E2F2F1;
  border: 1rpx solid #CBE4E1;
}

.tab-item.active .tab-text {
  font-weight: 600;
}
